{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "outDir": "web/dist",
    "rootDir": "web/src",
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["web/src/**/*.ts"]
}
